# Copy this file to .env and replace the placeholders with your own values.
# .env is git-ignored. NEVER commit it or paste its contents anywhere public.

# --- Gemini (required) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
# Optional. If unset, the app uses gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Google Calendar OAuth (all three required) ---
# 1. In Google Cloud Console, enable the Google Calendar API and create an OAuth
#    client ID of type "Desktop app" (see README.md, "Google Calendar setup").
# 2. Put the client ID and secret below.
# 3. Run scripts/get_refresh_token.py once to obtain GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_refresh_token_here

# The calendar to check and book. "primary" is the main calendar of the authorized
# Google account; otherwise use a calendar ID (Calendar settings -> Integrate calendar).
GOOGLE_CALENDAR_ID=primary

# --- Scheduling behavior (all optional; the values below are the defaults) ---
# IANA timezone name, e.g. Asia/Riyadh, Europe/London, America/New_York
TIMEZONE=Asia/Riyadh
WORK_START_HOUR=9
WORK_END_HOUR=21
DEFAULT_EVENT_DURATION_MINUTES=30

# --- Misc (optional) ---
LOG_LEVEL=INFO
